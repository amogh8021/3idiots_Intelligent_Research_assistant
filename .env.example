# ResearchDesk Unified Environment Variables Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ==============================================================================
# 1. Spring Boot Backend Configuration
# ==============================================================================
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5433/researchdesk
DATABASE_USERNAME=researchdesk
DATABASE_PASSWORD=researchdesk

# Azure Blob Storage — fill in your real connection string in .env
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=research-documents

# AI / RAG Service URL
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30
AI_FALLBACK_MOCK_ENABLED=true

# Frontend CORS Origin
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# File Upload Limits
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=55MB

# ==============================================================================
# 2. Python AI / RAG Service Configuration (ai-service/.env)
# ==============================================================================
HOST=0.0.0.0
AI_PORT=8000
LOG_LEVEL=INFO

# Hugging Face Settings (leave HF_API_TOKEN empty to use offline vectorizer)
HF_API_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_GENERATION_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# RAG Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
SIMILARITY_THRESHOLD=0.25

# Azure Blob Storage for AI Service — fill in your real connection string in .env
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=research-documents

# ==============================================================================
# 3. Azure Functions Configuration (azure-functions/local.settings.json)
# ==============================================================================
AzureWebJobsStorage=
FUNCTIONS_WORKER_RUNTIME=python
